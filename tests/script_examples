# fauna <x1,y1>-<x2,y2> type
#   Fish, Birds, Rabbits, Foxes, Deer, Bear
fauna <-0.35,0.30>-<-0.30,0.40>   Fish
fauna <-0.25,0.30>-<-0.20,0.40>   Birds
