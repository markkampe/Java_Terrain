#
# Sample map creation script, illustraing all of the supported commands
#
# Note:
#       x/y coordinates are given as a fraction of the xy_scale
#	x/y sizes can be in 'm', 'km' or fraction of the xy_scale
#	z sizes can be in 'm', 'km' or a fraction of the z_scale

# map identification
set region "Scripting Examples"
set author "Sagredo"
set description "worldBuilder script, illustrating all supported commands"

# land-mass location and orientation
set lat 34.05
set lon 118.24
set z_scale 4000m	# +/- 2000m
set xy_scale 250km	# 250km on a side

# continental elevation and slope
raise <-0.5,-0.5>-<0.5,0.5> 100m
slope 45 0.001		# axis, dz/dx
# sealevel -1m		# probably better done with "raise/lower"

# display options
#   Topo, Rain, Water, Erode, Minerals, Flora, Animals, Cities
set z_minor 25		# minor topo-line / 25m
set min/maj 4		# major topo-lines every 100m
display TRWMFAC

# a few rain bands (to provide contrast)
rainfall <-0.50,-0.50>-<0.50,-0.30>  100
region <0.40,-0.40> "rainfall 100cm/y"

rainfall <-0.50,-0.25>-<0.50,-0.05>  200cm/y
region <0.40,-0.150> "rainfall 200cm/y"

rainfall <-0.50,0.00>-<0.50,0.20>  300cm/y
region <0.32,0.12> "rainfall 300cm/y"

rainfall <-0.50,0.25>-<0.50,0.45>  400cm/y
region <0.15,0.27> "rainfall 400cm/y"

# mountain <x,y> height radius [profile]
outline square
mountain <-0.35,-0.35> 0.10 0.10 round
region <-0.43,-0.35> "mountain: h=200m, r=25km"

# ridge <x1,y1>-<x2,y2> height radius [profile]
outline elipse
ridge <-0.10,-0.45>-<-0.10,-0.25> 200m 10km cone
region <-0.18,-0.35> "conical ridge: h=200m, r=10km"

# mountain <x,y> height radius [profile]
outline square
mountain <0.10,-0.35> .1km 20000m flat
region <0.02,-0.35> "plateau: h=100m, r=20km"

# pit <x,y> height radius profile
outline square
pit <-0.35,-0.15> -0.05 0.04 round
region <-0.40,-0.15> "pit: h=100m, r=10km"

# valley <x1,y1>-<x2,y2> height radius [profile]
valley <-0.20,-0.15>-<0.00,-0.15> -150m 10km cone
region <-0.15,-0.15> "valley: h=150m, r=10km"

# points-of-interest <x,y> name description
region	<0.12,-0.20> "Points of Interest"
capital	<0.10,-0.17> Metropolis		"capital of the empire"
city	<0.20,-0.17> Gotham		"the big city"
town	<0.10,-0.12> Inverness		"a nice town"
village	<0.20,-0.12> Willowmere		"in the boonies"
entrypoint <0.10,-0.09> "Eintrit"	"teleport pad"
exitpoint  <0.20,-0.09>	"Ausgang"	"dimensional gate"

# trade routes between points of interest
traderoute <0.10,-0.17>-<0.20,-0.17>	# Metropolis->Gotham
traderoute <0.10,-0.17>-<0.10,-0.22>	# Metropolis->Invernes
traderoute <0.10,-0.12>-<0.20,-0.12>	# Inverness->Willowmere

# river <x,y> flow-rate
river <-0.5,0.0> 200m3/s
region <-0.49,0.01> "river: 200m3/s"

# minerals <x1,y1>-<x2,y2> type
minerals <-0.45,0.0>-<-0.40,0.1>   "Sand Stone"
minerals <-0.35,0.0>-<-0.30,0.1>   "Lime Stone"
minerals <-0.25,0.0>-<-0.20,0.1>   Marble
minerals <-0.15,0.0>-<-0.10,0.1>   Granite
minerals <-0.05,0.0>-<0.00,0.1>    Basalt
minerals  <0.05,0.0>-<0.10,0.1>	   "Copper Ore"
minerals  <0.15,0.0>-<0.20,0.1>	   "Iron Ore"
minerals  <0.25,0.0>-<0.30,0.1>	   Silver
minerals  <0.35,0.0>-<0.40,0.1>	   Gold

region <-0.45,0.05> "Sand Stone"
region <-0.35,0.05> "Lime Stone"
region <-0.25,0.05> "Marble"
region <-0.15,0.05> "Granite"
region <-0.05,0.05> "Basalt"
region  <0.05,0.05> "Copper"
region  <0.15,0.05> "Iron"
region  <0.25,0.05> "Silver"
region  <0.35,0.05> "Gold"

# flora <x1,y1>-<x2,y2> type
flora <-0.45,0.15>-<-0.40,0.25>   Taiga
flora <-0.35,0.15>-<-0.30,0.25>   Temperate_Rainforest
flora <-0.25,0.15>-<-0.20,0.25>   Tropical_Rainforest
